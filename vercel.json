{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/tts",
      "destination": "https://translate.google.com/translate_tts"
    },
    {
      "source": "/((?!assets/|favicon\\.svg$|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
